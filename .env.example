# AXIOM environment configuration
# Copy to `.env` and fill in. Never commit a real `.env` to git.

# ── Phase 5.7 — self-organizing brain ──────────────────────────────────
# Anthropic Haiku is the LLM fallback for the hybrid cluster classifier.
# When unset, the classifier silently degrades to the keyword tier and the
# canonical default cluster (decisions_policy). Cost: ~$0.0001 per call,
# only invoked on ambiguous or unmatched entity titles, results cached.
ANTHROPIC_API_KEY=

# ── Search embeddings (optional) ───────────────────────────────────────
# Hybrid/Semantic search uses OpenAI embeddings when set; otherwise a local
# deterministic hash embedding is used (no API key required).
# You can also store an OpenAI key in Settings → LLM Providers (vault).
# OPENAI_API_KEY=
# AXIOM_EMBEDDING_MODEL=text-embedding-3-small

# ── Storage ────────────────────────────────────────────────────────────
# SQLAlchemy URL. Defaults to `sqlite:///./axiom.db` when unset.
# DATABASE_URL=sqlite:///./axiom.db

# ── Phase 5.13.0 — encrypted secrets vault ─────────────────────────────
# Fernet master key (32-byte url-safe base64) for the AXIOM secrets vault.
# Required for any operation that reads or writes plaintext credentials.
# Generate one with:  python -m axiom.cli vault init
# Losing this key makes every stored secret permanently unreadable. Back it up.
AXIOM_VAULT_KEY=

# ── Connectors — background sync ───────────────────────────────────────
# Seconds between automatic sync cycles for connected OAuth connectors.
# AXIOM_CONNECTOR_SYNC_INTERVAL_SECONDS=300
# Delay before the first sync after server startup (seconds).
# AXIOM_CONNECTOR_SYNC_STARTUP_DELAY_SECONDS=2
